# Git
.git
.gitignore
.gitattributes

# Docker
Dockerfile
docker-compose.yml
.dockerignore

# IDE
.idea
.vscode
*.swp
*.swo
*~
.project
.classpath
.settings
nbproject

# OS
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
logs/
application/logs/*
!application/logs/.gitkeep

# Cache
application/cache/*
!application/cache/index.html
!application/cache/.gitkeep
*.cache

# Node modules (if any)
node_modules/
npm-debug.log
yarn-error.log

# Environment files
.env
.env.local
.env.*.local

# Documentation
docs/
*.md
!docker/README.md

# Database backups (keep SQL files, ignore backups)
db/*.nb3
db/*.backup
# Exclude large SQL files from Docker build (not needed in production image)
db/main/*.sql
db/audit/*.sql
!db/main/.gitkeep
!db/audit/.gitkeep

# PHP binaries (not needed in container)
.php
php/

# Uploads
uploads/*
!uploads/.gitkeep

# Temporary files
*.tmp
*.temp
*.bak
*.swp

